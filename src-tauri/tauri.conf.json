{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writing Studio",
  "version": "0.1.1",
  "identifier": "com.mcauliffe.writingstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Writing Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A calm Markdown writing app for books",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMTc3RjZDMUEyQjY1NkUKUldSdVpTc2FiSDhYMjZYVDVXOEhyVTBSK2tzU1UzdktYbWthK0Z5QnNKdVNWZUsrNDRuc0o0L2cK",
      "endpoints": [
        "https://github.com/docmcauliffe-cmd/writing-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
